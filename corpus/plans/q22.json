{
  "question": "combine street, city and postcode into one address, skipping blanks",
  "expect": {
    "valid": true,
    "warnings": [],
    "output": [
      "contact_id: string",
      "first_name: string",
      "last_name: string",
      "email: string",
      "phone: string",
      "company: string?",
      "street: string?",
      "city: categorical",
      "postcode: string?",
      "address: string",
      "region: categorical",
      "signup_date: date",
      "status: categorical",
      "fax: string?",
      "lifetime_value: currency:INR"
    ],
    "impact": {
      "added": [
        "address"
      ]
    }
  },
  "plan": {
    "kind": "edit",
    "target": "Contacts",
    "ops": [
      {
        "op": "addColumn",
        "as": "address",
        "expr": {
          "type": "concat",
          "parts": [
            {
              "type": "col",
              "col": "street"
            },
            {
              "type": "col",
              "col": "city"
            },
            {
              "type": "col",
              "col": "postcode"
            }
          ],
          "sep": ", ",
          "skipNulls": true
        },
        "position": {
          "at": "after",
          "column": "postcode"
        }
      }
    ],
    "params": []
  }
}
