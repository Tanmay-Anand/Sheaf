{
  "name": "sheaf-addin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "office-addin-debugging start manifest.xml desktop",
    "start:web": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "generate-types": "json2ts --input ../contract/schema/plan.schema.json --output ../contract/types/plan.d.ts --bannerComment ''",
    "validate-manifest": "office-addin-manifest validate manifest.xml"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.55.0",
    "@microsoft/office-js": "^1.1.86",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-manifest": "^2.1.6",
    "@types/node": "^22.0.0",
    "@types/office-js": "^1.0.404",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "eslint": "^9.0.0",
    "html-webpack-plugin": "^5.6.0",
    "json-schema-to-typescript": "^15.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.3",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
