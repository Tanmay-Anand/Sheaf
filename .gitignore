# ── Build outputs ─────────────────────────────────────────────────────────────
service/.jqwik-database
service/target/
addin/dist/
addin/node_modules/

# ── Generated contract (regenerated at build time; snapshot committed) ─────────
# contract/ is NOT ignored — the snapshot is checked in and diffed in CI.
# Only ignore any local temp files inside it.
contract/schema/.tmp/
contract/types/.tmp/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Dev certs (generated locally by office-addin-dev-certs) ──────────────────
addin/.ssl/

# ── Env / secrets ─────────────────────────────────────────────────────────────
.env
.env.local
*.env

# ── Log files ─────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Maven wrapper (if added later) ────────────────────────────────────────────
.mvn/wrapper/maven-wrapper.jar

# Private working docs
Inside-docs/
